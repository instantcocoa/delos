{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/instantcocoa/delos/main/docs/schemas/prompt.schema.json",
  "title": "Delos Prompt File",
  "description": "A single versioned prompt stored in a git repository as <slug>.prompt.yaml. The repository is the source of truth; the Delos control plane is an index and serving cache.",
  "type": "object",
  "required": ["name", "slug", "messages"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable prompt name."
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$",
      "description": "Stable, URL-friendly identifier. Must match the file name: <slug>.prompt.yaml."
    },
    "description": {
      "type": "string",
      "description": "What this prompt does and when to use it."
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered chat messages. Content may contain {{variable}} placeholders.",
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "enum": ["system", "user", "assistant"]
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "variables": {
      "type": "array",
      "description": "Variables that may be interpolated into message content.",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["string", "number", "boolean", "json"]
          },
          "required": {
            "type": "boolean"
          },
          "default": {
            "type": "string",
            "description": "Default value, always written as a string (rendering is textual substitution)."
          }
        }
      }
    },
    "config": {
      "type": "object",
      "description": "Default generation parameters.",
      "additionalProperties": false,
      "properties": {
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "top_p": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "stop": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "output_schema": {
          "type": "string",
          "description": "JSON Schema (as a string) for structured output."
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metadata": {
      "type": "object",
      "description": "Arbitrary string key/value metadata.",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
