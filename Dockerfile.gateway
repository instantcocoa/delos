# delos-gateway - the data plane: a stateless LLM gateway on port 8080.
# Needs no database; providers are configured entirely through env vars.

# Build stage
FROM golang:1.25-alpine AS builder

RUN apk add --no-cache git ca-certificates

# Install buf for proto code generation
RUN go install github.com/bufbuild/buf/cmd/buf@v1.47.2

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

# Copy proto files and generate code
COPY buf.yaml buf.gen.yaml ./
COPY proto/ proto/
RUN buf generate

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /bin/delos-gateway ./cmd/delos-gateway

# Final stage
FROM alpine:3.19

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app

COPY --from=builder /bin/delos-gateway /app/delos-gateway

# Run as non-root
RUN adduser -D -u 1000 delos
USER delos

EXPOSE 8080

ENTRYPOINT ["/app/delos-gateway"]
