# Delos Configuration
# ====================
#
# Delos is two binaries + Postgres:
#   delos-gateway   data plane,  HTTP :8080, stateless, needs no database
#   delos           control plane + CLI; `delos serve` listens on :8081
#
# File Hierarchy:
#   .env           - Base config for Docker Compose (safe to check in)
#   .env.local     - Your local overrides and secrets (gitignored)
#
# To configure:
#   1. cp .env.example .env
#   2. Put your provider API keys in .env.local (create if needed)

# =============================================================================
# General Settings
# =============================================================================

# Environment name (development, staging, production)
DELOS_ENV=development

# Log level (debug, info, warn, error)
DELOS_LOG_LEVEL=debug

# Log format (text, json)
DELOS_LOG_FORMAT=text

# =============================================================================
# LLM Provider API Keys (delos-gateway)
# =============================================================================
# Put real keys in .env.local - DO NOT commit them!
# The gateway registers a provider for every key it finds.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Other providers (optional)
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=

# AWS Bedrock (needs both key id and secret)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Google Vertex AI
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_CLOUD_ACCESS_TOKEN=

# Local models via Ollama (optional 'ollama' compose profile)
# For Docker: http://ollama:11434   For local: http://localhost:11434
# DELOS_RUNTIME_OLLAMA_ENABLED=true
# DELOS_RUNTIME_OLLAMA_URL=http://ollama:11434

# Gateway listen port (default 8080)
# DELOS_GATEWAY_PORT=8080

# =============================================================================
# Control Plane (delos serve)
# =============================================================================

# Listen port for `delos serve` (default 8081)
DELOS_PORT=8081

# Where the control plane (and the CLI) reach the gateway
# For Docker: http://gateway:8080   For local: http://localhost:8080
DELOS_GATEWAY_URL=http://gateway:8080

# Storage backend: memory (default, ephemeral) or postgres
DELOS_STORAGE_BACKEND=postgres

# PostgreSQL - the control plane applies its own migrations at startup.
# For Docker: use service name "postgres"   For local: "localhost"
DELOS_DB_HOST=postgres
DELOS_DB_PORT=5432
DELOS_DB_USER=delos
DELOS_DB_PASSWORD=delos
DELOS_DB_NAME=delos
DELOS_DB_SSLMODE=disable

# =============================================================================
# CLI
# =============================================================================

# Where the CLI reaches the control plane (gRPC host:port, no scheme)
# DELOS_CONTROL_PLANE_ADDR=localhost:8081

# API key the CLI/SDK-style clients present to the gateway
# DELOS_GATEWAY_API_KEY=delos-dev

# =============================================================================
# Observability / Tracing
# =============================================================================

# Enable OpenTelemetry tracing (optional 'observability' compose profile
# starts Jaeger with an OTLP collector on :4317)
DELOS_TRACING_ENABLED=false

# Sampling rate (0.0 to 1.0, where 1.0 = 100% of traces)
DELOS_TRACING_SAMPLING=1.0

# OTLP endpoint for traces
# DELOS_OBSERVE_ENDPOINT=jaeger:4317
