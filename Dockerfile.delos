# delos - control plane + CLI in one binary.
# `delos serve` runs the control plane on port 8081; every other subcommand
# is a client of it.

# Build stage
FROM golang:1.25-alpine AS builder

RUN apk add --no-cache git ca-certificates

# Install buf for proto code generation
RUN go install github.com/bufbuild/buf/cmd/buf@v1.47.2

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

# Copy proto files and generate code
COPY buf.yaml buf.gen.yaml ./
COPY proto/ proto/
RUN buf generate

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /bin/delos ./cmd/delos

# Final stage
FROM alpine:3.19

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app

COPY --from=builder /bin/delos /app/delos

# Run as non-root
RUN adduser -D -u 1000 delos
USER delos

EXPOSE 8081

ENTRYPOINT ["/app/delos"]
CMD ["serve"]
