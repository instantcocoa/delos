{
  "name": "openai: an explicit \"stop\": null is unset, not an empty stop sequence",
  "provider": "openai",
  "surface": "openai",
  "request": {
    "model": "gpt-4o",
    "messages": [
      {
        "role": "user",
        "content": "Say hello."
      }
    ],
    "stop": null
  },
  "upstream_path_contains": "/v1/chat/completions",
  "upstream_body_excludes": [
    "\"stop\""
  ],
  "upstream_responses": [
    {
      "status": 200,
      "content_type": "application/json",
      "body": "{\"id\":\"chatcmpl-STOP2\",\"object\":\"chat.completion\",\"created\":1730000000,\"model\":\"gpt-4o-2024-08-06\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"Hello there!\"},\"logprobs\":null,\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":11,\"completion_tokens\":3,\"total_tokens\":14}}"
    }
  ],
  "expect": {
    "status": 200,
    "json_paths": {
      "choices.0.message.content": "Hello there!"
    }
  }
}
