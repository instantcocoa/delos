  "endpoint": "/v1/embeddings",
  "request": {
    "model": "text-embedding-3-small",
    "input": "hello world"
  },
  "upstream_path_contains": "/v1/embeddings",
  "upstream_body_contains": [
    "hello world",
    "text-embedding-3-small"
  ],
