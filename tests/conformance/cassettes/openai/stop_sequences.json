{
  "name": "openai: stop sequences reach the backend and length is reported",
  "provider": "openai",
  "surface": "openai",
  "request": {
    "model": "gpt-4o",
    "messages": [
      {
        "role": "user",
        "content": "Count to three."
      }
    ],
    "stop": [
      "THREE",
      "\n\n"
    ]
  },
  "upstream_path_contains": "/v1/chat/completions",
  "upstream_body_contains": [
    "\"stop\":[\"THREE\"",
    "\\n\\n"
  ],
  "upstream_responses": [
    {
      "status": 200,
      "content_type": "application/json",
      "body": "{\"id\":\"chatcmpl-STOP1\",\"object\":\"chat.completion\",\"created\":1730000000,\"model\":\"gpt-4o-2024-08-06\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"one two \"},\"logprobs\":null,\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":12,\"completion_tokens\":3,\"total_tokens\":15}}"
    }
  ],
  "expect": {
    "status": 200,
    "json_paths": {
      "choices.0.finish_reason": "stop",
      "choices.0.message.content": "one two "
    }
  }
}
